class ActType:
	def __init__(self, name, params):
		self.name = name     # str
		self.params = params # list(int)

	def __str__(self):
		if self.params:
			return self.name + "<" + ",".join([str(param) for param in self.params]) + ">"
		else:
			return self.name

	def flatten(self, params):
		for i, param in enumerate(self.params):
			self.params[i] = str(evalExp(param, params))

	def isBundledData(self):
		return self.name.startswith("bus2_") or self.name.startswith("bus_")


class ActArg:
	def __init__(self, name, size, vtype):
		self.name = name   # str
		self.size = size   # list(int)
		self.vtype = vtype # ActType

	def flatten(self, params):
		self.vtype.flatten(params)
		for i, size in enumerate(self.size):
			self.size[i] = str(evalExp(size, params))

	def signalName(self):
		result = self.name
		if self.vtype.isBundledData():
			result += ".c"
		return result

	def signalRails(self):
		if self.vtype.isBundledData():
			return self.vtype.params[1]
		elif len(self.vtype.params) > 0:
			return self.vtype.params[0]
		else:
			return 0

	def index(self, i):
		return ActArg(self.name + "[" + str(i) + "]", self.size[1:], self.vtype)

	def instName(self):
		return self.name + "".join(["[" + s + "]" for s in self.size])

	def inst(self):
		return str(self.vtype) + " " + self.instName()

	def count(self):
		if len(self.size) > 0:
			return self.size[-1]
		return 0

	def sinkType(self):
		result = copy.deepcopy(self.vtype)
		if result.name.startswith("bus2_"):
			result.name = result.name[5:]
			result.params = [result.params[1]]
		elif result.name.startswith("bus_"):
			result.name = result.name[4:]
			result.params = [result.params[1]]
		result.params.append(6)
		return result

	def sink(self):
		lines = []
		if "[" not in self.name:
			lines.append("sink_{vtype} sink_{name};".format(
				vtype = str(self.sinkType()),
				name = self.instName(),
			))
		if len(self.size) > 0:
			for i in range(0, int(self.size[0])):
				lines += self.index(i).sink()
		else:
			lines.append("sink_{name}(g, {signals});".format(
				name = self.name,
				signals = self.signalName(),
			))
		return "\n".join(lines)

	def emitBundle(self):
		if len(self.size) > 0:
			lines = []
			for i in range(0, int(self.size[0])):
				lines += self.index(i).emitBundle()
			return lines
		
		if self.vtype.name.endswith("e1of") or self.vtype.name.endswith("eMofN") or self.vtype.name.endswith("a1of") or self.vtype.name.endswith("aMofN") or self.vtype.name.endswith("c1of") or self.vtype.name.endswith("cMofN"):
			return ["bundle dut.{name}.d[0:{rails}]".format(
				name  = self.signalName(),
				rails = self.signalRails(),
			)]

		return []

	def emit(self, chp):
		if len(self.size) > 0:
			lines = []
			for i in range(0, int(self.size[0])):
				lines += self.index(i).emit(chp.index(i))
			return lines

		if self.vtype.name in ["bool", "pair"]:
			if chp.name in ["false", "true"]:
				value = (1 if chp.name == "true" else 0)
				if self.vtype.name == "bool":
					return ["set dut.{name} {value}".format(name=self.name, value=value)]
				else:
					return [
						"set dut.{name}.d[1] {value}".format(name=self.name, value=value),
						"set dut.{name}.d[0] {value}".format(name=self.name, value=1-value)
					]
			elif chp.clk and chp.name:
				return prsimEmitBus(self.name, chp.clk, self.count(), chp.posedge, self.vtype.name == "pair", chp.name, chp.vdir)
			return []

		protocol = ""
		ack = chp.clk
		posedge = chp.posedge
		clk = chp.clk
		if self.vtype.name.endswith("e1of") or self.vtype.name.endswith("eMofN") or self.vtype.name.endswith("ePxMofN"):
			protocol = "e"
			ack = ""
			clk = self.signalName()+".e"
			posedge = True
		elif self.vtype.name.endswith("a1of") or self.vtype.name.endswith("aMofN") or self.vtype.name.endswith("aPxMofN"):
			protocol = "a"
			ack = ""
			clk = self.signalname()+".a"
			posedge = False
		elif self.vtype.name.endswith("c1of") or self.vtype.name.endswith("cMofN") or self.vtype.name.endswith("cPxMofN"):
			protocol = ("a" if chp.ack else "e")

		lines = []
		if protocol:
			req = self.signalName() + ".d[0:{rails}]".format(rails=self.signalRails())
			data = chp.name + (".C" if self.vtype.isBundledData() else "")
			lines += prsimEmitChan(self.signalName(), protocol, req, ack, data, chp.vdir)

		if self.vtype.name.startswith("bus2_") or self.vtype.name.startswith("bus_"):
			data = chp.name + (".D" if self.vtype.isBundledData() else "")
			lines += prsimEmitBus(self.name, clk, self.vtype.params[0], posedge, self.vtype.name.startswith("bus2_"), data, chp.vdir)
		return lines

class ActProcess:
	def __init__(self, path, tmpl, args):
		self.path = path
		self.tmpl = tmpl
		self.args = args

	def flatten(self, values):
		params = {param.name: value for param, value in zip(self.tmpl, values)}

		result = copy.deepcopy(self)
		for arg in result.args:
			arg.flatten(params)
		return result

	def argdef(self):
		return "; ".join([arg.inst() for arg in self.args])

	def arglist(self):
		return ",".join([arg.name for arg in self.args])	

class ActInstance:
	def __init__(self, name, tmpl, args):
		self.name = name
		self.tmpl = tmpl
		self.args = args

	def test(self):
		return self.name.replace('::', '_') + '_' + '_'.join(self.tmpl)

	def typestr(self):
		return self.name + "<" + ",".join(self.tmpl) + ">"

def parseArgs(line):
	result = []
	for arg in line.split(","):
		result.append(arg.strip())
	return result

def parseActType(line):
	o = line.find("<")
	c = line.rfind(">")
	if o != -1 and c != -1:
		return ActType(line[0:o], parseArgs(line[o+1:c]))
	else:
		return ActType(line, [])

def parseArray(line):
	name = ""
	size = []

	terms = line.strip().split("[")
	name = terms[0]
	size = [term[0:-1] for term in terms[1:]]
	return (name, size)
	
def parseActArgs(line):
	args = []
	for elem in line.split(";"):
		m = re.match(r'([a-zA-Z_][a-zA-Z_0-9]*(?:<[^>]*>)?) *(.*)', elem.strip())
		if m is not None:
			argtype = parseActType(m.group(1).strip())
			for arg in m.group(2).split(","):
				name, argsize = parseArray(arg)
				args.append(ActArg(name, argsize, argtype))
	return args

def parseActProcess():
	processes = {}
	for line in os.popen("find * -name '*.act' | grep -v \"test/\""):
		path = line.strip()
		with open(path, "r") as fptr:
			for m in re.findall(r'(?:template\s*<([^>]*)>)?\s*(?:export\s*)?defproc\s*([A-Za-z_][A-Za-z0-9_]*)\(([^\)]*)\)', fptr.read()):
				if m[1] != '':
					tmpl = None
					if m[0] != '':
						tmpl = parseActArgs(m[0])
					name = m[1]
					args = parseActArgs(m[2])
					processes[name] = ActProcess(path, tmpl, args)
	return processes

