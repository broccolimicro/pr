def emitTest():
	root = projectRoot()
	if root == "/":
		print("pr test: go.mod file not found in current directory or any parent directory")

	processes = parseActProcess()
	tests = parseChpTest()
	
	for test in tests:
		name = test.proc.name
		if ':' in name:
			idx = name.rindex(':')
			name = name[idx+1:]

		if name in processes:
			proc = processes[name].flatten(test.proc.tmpl)
			path = test.createDir()
			relCwd = relativeCwd(root)
			if relCwd != ".":
				proc.path = relCwd + "/" + proc.path
			if proc.path.startswith("prs/"):
				proc.path = proc.path[4:]

			for arg, val in zip(proc.args, test.proc.args):
				createInjectExpect(path, arg, val)

			emitTestAct(path, test, proc)

			emitPrsimRc(path, "prsim.rc", test, proc, False)
			emitPrsimRc(path, "xyce.rc", test, proc, True)

def runSim(prs, prsim):
	sim = subprocess.Popen(["prsim", prs], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
	sim.stdin.write("source {}\n".format(prsim))
	sim.stdin.write("quit\n")
	out, err = sim.communicate()
	if err:
		print(err)
	sim.stdin.close()

	with open("test.sim", "w") as fptr:
		print(out, file=fptr)
	return out

