class ChpStruct:
	def __init__(self, desc):
		desc = desc.strip()
		self.name = ""
		self.dtype = ""
		self.members = []
		if len(desc) == 0:
			return

		structStart = desc.index('{') if '{' in desc else len(desc)
		nameStart = desc.index(':') if ':' in desc else len(desc)
		if nameStart < structStart and nameStart < len(desc):
			self.name = desc[0:nameStart]
			desc = desc[nameStart+1:]
			structStart -= nameStart+1
		if structStart < len(desc):
			self.members = [ChpStruct(arg) for arg in desc[structStart+1:-1].split(" ")]

		self.dtype = desc

	def __str__(self):
		return (self.name + ":" if self.name else "") + (self.dtype if self.dtype else "")

	# return list of indexes into members for a particular member name
	def addr(self, name):
		search = name
		sub = ""
		if '.' in search:
			idx = search.index('.')
			sub = search[idx+1:]
			search = search[0:idx]

		for i, member in enumerate(self.members):
			if member.name == search:
				return [i] + member.addr(sub)

		return []

	# return a particular member given a list of indexes
	def at(self, idx):
		if len(idx) == 0:
			return self
		elif idx[0] < len(self.members):
			return self.members[idx[0]].at(idx[1:])
		else:
			return None

class ChpArg:
	def __init__(self, name, vdir, clk="", posedge=True, ack=False):
		self.name = name
		self.vdir = vdir
		self.clk = clk
		self.posedge = posedge
		self.ack = ack

	def index(self, i):
		return ChpArg(self.name + "." + str(i), self.vdir, self.clk, self.posedge, self.ack)

def parseChpArgs(line):
	result = []
	for arg in line.split(","):
		arg = arg.strip()
		vdir = ""
		ack = False
		clk = ""
		posedge = True
		if '@' in arg:
			lst = arg.split("@")
			arg = lst[0]
			clk = lst[1]
			if len(clk) > 0 and clk[-1] in "+-":
				if clk[-1] == "-":
					posedge = False
				clk = clk[0:-1]

		if len(arg) > 0 and arg[-1] in "?!":
			vdir = arg[-1]
			arg = arg[0:-1]
		elif len(arg) > 1 and arg[-2] in "?!" and arg[-1] in "+-":
			vdir = arg[-2]
			ack = arg[-1] == "+"
			arg = arg[0:-2]
		
		result.append(ChpArg(arg, vdir, clk, posedge, ack))
	return result

class ChpTest:
	def __init__(self, proc, chptest):
		self.proc = proc
		self.chptest = chptest

	def testPath(self):
		name = shlex.quote(self.proc.test())
		if name[0] == '\'' and name[-1] == '\'':
			name = name[1:-1]
		return os.getcwd() + "/test/" + name

	def createDir(self):
		path = self.testPath()

		chp = ""
		for item in self.chptest[1:len(self.chptest)]:
			if chp != "":
				chp += " "
			chp += shlex.quote(item)

		cmd = 'go test ' + projectRoot() + '/... -v -run ' + shlex.quote("^"+self.chptest[0]+"$") + ' -args'
		if "ACT_PROFILE" in os.environ:
			cmd += ' \"' + projectRoot() + '/$ACT_PROFILE\"'
		else:
			cmd += ' \"\" '
		cmd += ' \'' + path + '/chp\' ' + chp

		os.system('mkdir -p \'' + path + '\'')
		print(cmd)
		os.system(cmd)
		
		return path

def parseChpTest():
	tests = []
	for line in os.popen("find * -name '*.act' | xargs grep -rh \"^//.*TestUnit\""):
		m = re.match(r'//\s*([^<]*)<([^>]*)>\(([^\)]*)\):(.*)', line)
		# TODO(edward.bingham) add support for multiple data streams for a single channel
		tests.append(ChpTest(ActInstance(m.group(1), parseArgs(m.group(2)), parseChpArgs(m.group(3))), m.group(4).strip().split(" ")))
	return tests

