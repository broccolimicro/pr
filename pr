def buildChan(sim, neutral=False, tohex=False):
	values = {}
	errors = {}
	
	length = 0
	skip = False
	cleanup = re.compile(r'\r[^\r]*\r')
	with open(sim, "r") as fptr:
		for l, line in enumerate(fptr):
			if "$finish" in line:
				break

			if l == 0 and "Chronologic VCS simulator" in line:
				skip = True

			if skip and "Maximum DC iterations" in line:
				skip = False
			elif not skip and "DC iteration" not in line and "DC initialization" not in line and "End of operating" not in line and "Memory usage" not in line:
				line = cleanup.sub('', line)
				idx = max([len(v) for v in values.values()] or [0])
				if len(line.strip()) > 0 and line[0] != '\t' and line[0] != '>':
					if line[0:5] == "ERROR" or line[0:7] == "WARNING":
						if idx not in errors:
							errors[idx] = ""
						errors[idx] += line
					else:
						value = [cell.strip(" \t\n{}()") for cell in line.split(': ')]
						if len(value) == 2 and (neutral or value[1] != "neutral"):
							if value[0] not in values:
								values[value[0]] = []

							if len(values[value[0]]) < length-1:
								values[value[0]].extend([":"]*(length-len(values[value[0]])-1))

							if tohex and value[1][0] in "0123456789":
								values[value[0]].append("%X" % int(value[1]))
							else:
								values[value[0]].append(value[1])
							
							if len(values[value[0]]) > length:
								length = len(values[value[0]])

	max_len = 0
	for key in values.keys():
		if len(values[key]) > max_len:
			max_len = len(values[key])

	ks = values.keys()
	keys = []
	other = []
	for k in ks:
		if '[' in k:
			idx = k[k.index('['):]
			k = k[0:k.index('[')]
			idx = [int(i) if ':' not in i else i for i in idx[1:-1].split('][')]
			keys.append((k, idx))
		else:
			other.append(k)

	keys = other + [k[0] + '[' + ']['.join([str(x) for x in k[1]]) + ']' for k in sorted(keys)]

	prefix = sim[0:-4]
	chan = prefix + '.chan'
	with open(chan, "w") as fptr:
		print('\t'.join(keys), file=fptr)
		for i in range(0, max_len):
			if i in errors:
				print(errors[i], file=fptr)
			print('\t'.join([values[key][i] if i < len(values[key]) else '' for key in keys]), file=fptr)

		for err in [e for i,e in errors.items() if i >= max_len]:
			print(err, file=fptr)
	return chan

