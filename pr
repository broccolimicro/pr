def createInjectExpect(path, act, chp):
	if len(act.size) > 0:
		for i in range(0, int(act.size[0])):
			createInjectExpect(path, act.index(i), chp.index(i))
		return
	
	elif chp.name and chp.vdir:
		chanpath = "{path}/chp/top.dut.{name}.{recv}".format(
			path=path,
			name=chp.name,
			recv=("r" if chp.vdir == '?' else "s"),
		)
		rec = None
		files = None
		with open(chanpath, "r") as chanptr:
			for i, line in enumerate(chanptr):
				if i == 0:
					# read the header
					rec = ChpStruct(line[10:])
					rec.name = chp.name
					files = openFileStruct(path, rec)
				else:
					inst = ChpStruct(line.split("\t")[1])
					writeFileStruct(files, inst)

