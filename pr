def openFileStruct(path, chp, name=""):
	if len(chp.name) > 0:
		if len(name) > 0:
			name += "."
		name += chp.name

	if len(chp.members) > 0:
		result = []
		for member in chp.members:
			result.append(openFileStruct(path, member, name))
		return result

	if len(name) > 0:	
		return open("{path}/{name}.dat".format(path=path,name=name), "w")

	return None

def closeFileStruct(files):
	for file in files:
		if isinstance(file, list):
			closeFileStruct(file)
		else:
			file.close()

def writeFileStruct(files, values):
	if len(values.members) > 0:
		for file, value in zip(files, values.members):
			writeFileStruct(file, value)
		return
	
	value = str(values)
	if value == "false":
		value = 0
	elif value == "true":
		value = 1
	print(value, file=files)


