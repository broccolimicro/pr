###############################################################################

class Token:
	def __init__(self, token_type, value=None):
		self.token_type = token_type
		self.value = value
		self.children = []

def lexExp(s):
	tokens = []
	curr = None
	for c in s:
		if c in ['+', '-', '*', '/', '(', ')']:
			if curr != None:
				tokens.append(curr)
				curr = None

			tokens.append(Token(c, value=c))
		elif (curr == None or curr.token_type != 'v') and re.match(r'\d', c):
			if curr != None and curr.token_type != 'n':
				tokens.append(curr)
				curr = None

			if curr != None:
				curr.value += c
			else:
				curr = Token('n', value=c)
		elif ((curr == None or curr.token_type != 'v') and re.match(r'[A-Za-z_]', c)) or (curr != None and curr.token_type == 'v' and re.match(r'[A-Za-z0-9_]', c)):
			if curr != None and curr.token_type != 'v':
				tokens.append(curr)
				curr = None

			if curr != None:
				curr.value += c
			else:
				curr = Token('v', value=c)
		else:
			raise Exception('Invalid token: {}'.format(c))
	if curr != None:
		tokens.append(curr)
	tokens.append(Token('e'))
	return tokens

def expectToken(tokens, token):
	if tokens[0].token_type == token:
		return tokens.pop(0)
	else:
		raise Exception('Invalid syntax on token {}'.format(tokens[0].token_type))

def parseExpAddSub(tokens):
	left_node = parseExpMulDiv(tokens)

	while tokens[0].token_type in ['+', '-']:
		node = tokens.pop(0)
		node.children.append(left_node)
		node.children.append(parseExpMulDiv(tokens))
		left_node = node

	return left_node

def parseExpMulDiv(tokens):
	left_node = parseExpParens(tokens)

	while tokens[0].token_type in ['*', '/']:
		node = tokens.pop(0)
		node.children.append(left_node)
		node.children.append(parseExpParens(tokens))
		left_node = node

	return left_node

def parseExpParens(tokens):
	if tokens[0].token_type == 'n':
		return tokens.pop(0)
	elif tokens[0].token_type == 'v':
		return tokens.pop(0)

	expectToken(tokens, '(')
	expression = parseExpAddSub(tokens)
	expectToken(tokens, ')')

	return expression

def parseExp(inputstring):
	tokens = lexExp(inputstring)
	ast = parseExpAddSub(tokens)
	expectToken(tokens, 'e')
	return ast

operations = {
	'+': operator.add,
	'-': operator.sub,
	'*': operator.mul,
	'/': operator.truediv
}

def evalExp(expr, params):
	node = expr
	if isinstance(expr, str):
		node = parseExp(expr)
	if node.token_type == 'n':
		return int(node.value)
	elif node.token_type == 'v':
		if node.value in params:
			return int(params[node.value])
	left_result = evalExp(node.children[0], params)
	right_result = evalExp(node.children[1], params)
	operation = operations[node.token_type]
	return operation(left_result, right_result)

