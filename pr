def bundle2int(bun):
	value = -1
	width = (len(bun)-1).bit_length()
	for i, c in enumerate(bun):
		if c == '1' and value == -1:
			value = i
		elif c == '1' and value >= 0:
			value = -2
	if value == -2:
		return 'x'*width # illegal
	elif value == -1:
		return '-'*width # neutral
	else:
		result = str(bin(value))[2:]
		result = '0'*(width-len(result)) + result
		return result

def vec2int(vec, sz):
	result = ""
	for i in range(0, len(vec), sz):
		result = bundle2int(vec[i:i+sz]) + result
	return result

def uniq(lst):
	used = set()
	return [(t,n) for t,n in lst if t not in used and (used.add(t) or True)]

def buildVCD(sim, normalize=False):
	signals = {}
	curid = ""
	lasttime = -1
	markers = []

	prefix = sim[0:-4]
	vcd = prefix + '.vcd'
	gtkw = prefix + '.gtkw'
	with open(sim, 'r') as fptr:
		with open(vcd, 'w') as vptr:
			# Header
			print("$date", file=vptr)
			print(datetime.datetime.now().strftime("%Y-%m-%d"), file=vptr)
			print("$end", file=vptr)
			print("$timescale 1ps $end", file=vptr)

			for line in fptr:
				line = line.strip()
				if len(line) > 0 and line[0].isdigit():
					line = re.split('[ \t]+', line)
					curtime = int(line[0])
					signal = line[1].replace(".", "_").replace("[", "").replace("]", "")
					if signal not in signals:
						signals[signal] = [signal, 1]

					while True:
						value = line[-1]
						vec = line[-1].split('=')
						if vec[-1][0] == '{':
							vecname = vec[-2].replace(".", "_").replace(":", "_").replace("[", "").replace("]", "")
							vecvalue = vec2int(vec[-1][1:-1], 2)
							if vecname not in signals:
								signals[vecname] = [vecname, len(vecvalue)]
							del line[-1]
						if vec[-1][0] == '(':
							vecname = vec[-2].replace(".", "_").replace(":", "_").replace("[", "").replace("]", "")
							vecvalue = vec2int(vec[-1][1:-1], len(vec[-1])-2)
							if vecname not in signals:
								signals[vecname] = [vecname, len(vecvalue)]
							del line[-1]
						else:
							vecname = ""
							vecvalue = ""
							break
			fptr.seek(0)

			name = [33,33,33]
			for key in reversed(sorted(signals.keys(), key=len)):
				signals[key][0] = chr(name[0]) + chr(name[1]) + chr(name[2])
				name[2] += 1
				if name[2] > 126:
					name[1] += 1
					name[2] = 33
				if name[1] > 126:
					name[0] += 1
					name[1] = 33

				print("$var wire " + str(signals[key][1]) + " " + signals[key][0] + " " + key + " " + "$end", file=vptr)

			print("$enddefinitions $end", file=vptr)
			
			# Initial Values
			print("$dumpvars", file=vptr)
			for key, value in signals.items():
				if value[1] == 1:
					print("x" + value[0], file=vptr)
				else:
					print("b" + "x"*value[1] + " " + value[0], file=vptr)
			# print X
			print("$end", file=vptr)

			# Value Change Section
			printtime = 0
			lastprinttime = 0
			for line in fptr:
				line = line.strip()
				if len(line) > 0:
					if line.startswith("WARNING"):
						if normalize:
							markers.append((lastprinttime, "WARNING"))
						else:
							markers.append((lasttime, "WARNING"))
					elif line.startswith("ERROR"):
						if normalize:
							markers.append((lastprinttime, "ERROR"))
						else:
							markers.append((lasttime, "ERROR"))
					elif line[0].isdigit():
						line = re.split('[ \t]+', line)
						curtime = int(line[0])
						signal = line[1].replace(".", "_").replace("[", "").replace("]", "")
						value = line[3]
						if curtime != lasttime:
							if normalize:
								print("#" + str(printtime), file=vptr)
							else:
								print("#" + str(curtime), file=vptr)
							lastprinttime = printtime
							printtime += 10
							lasttime = curtime

						print(value + signals[signal][0], file=vptr)

						while True:
							vec = line[-1].split('=')
							if vec[-1][0] == '{':
								vecname = vec[-2].replace(".", "_").replace(":", "_").replace("[", "").replace("]", "")
								vecvalue = vec2int(vec[-1][1:-1], 2)
								del line[-1]
							elif vec[-1][0] == '(':
								vecname = vec[-2].replace(".", "_").replace(":", "_").replace("[", "").replace("]", "")
								vecvalue = vec2int(vec[-1][1:-1], len(vec[-1])-2)
								del line[-1]
							else:
								vecname = ""
								vecvalue = ""
								break
							
							if vecname and vecname in signals:
								if signals[vecname][1] == 1:
									print(vecvalue + signals[vecname][0], file=vptr)
								else:
									print("b" + vecvalue + " " + signals[vecname][0], file=vptr)
	
		with open(gtkw, 'w') as gptr:
			print("[dumpfile] \"" + os.getcwd() + "/" + vcd + "\"", file=gptr)
			print("[savefile] \"" + os.getcwd() + "/" + gtkw + "\"", file=gptr)
			markers = uniq(markers)
			print("*1.0 0 " + " ".join([str(t) for t, n in markers]), file=gptr)
			for l, (t, n) in zip("ABCDEFGHIJKLMNOPQRSTUVWXYZ", markers):
				print("[markername] " + l + n, file=gptr)

	return vcd

